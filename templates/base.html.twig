<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}<!-- Aquí irá el titulo de la pagina -->{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">

    <header class="bg-dark text-white p-3">
        <h1 class="text-center">API Slim PHP</h1>
    </header>

    <main class="container my-4">
        {% block content %}
        <!-- Aquí irá el contenido de cada página -->
        {% endblock %}
    </main>

    <footer class="bg-dark text-white text-center p-3 mt-auto">
        <p>© {{ "now"|date("Y") }} Autor Alex Ernesto Castillo - Todos los derechos reservados</p>
    </footer>

</body>
</html>
